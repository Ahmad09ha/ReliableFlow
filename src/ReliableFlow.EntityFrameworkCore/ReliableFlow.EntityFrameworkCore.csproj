<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ReliableFlow.EntityFrameworkCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Ahmad09ha</Authors>
    <Description>Reusable EF Core transactional outbox and idempotent inbox primitives with an optional hosted outbox relay.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Ahmad09ha/ReliableFlow</RepositoryUrl>
    <PackageTags>outbox;inbox;idempotency;distributed-systems;efcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
